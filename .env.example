# ============================================================
#  数字人 · 服务端默认配置
#  复制为 .env 后按需填写；.env 已被 .gitignore 排除
#
#  ⚠ 这里填的是「服务端兜底密钥」。
#    网页设置面板里让用户填的自带密钥永远优先，且只存在浏览器本地，
#    不会写进这个文件、不会进数据库、不会出现在日志里。
# ============================================================

# ---- 服务 ----
DH_HOST=127.0.0.1
DH_PORT=8000
DH_LOG_LEVEL=info

# ---- 默认大脑（LLM）：留空 = 走离线回声模式，先用着再配 ----
# 支持 openai 兼容协议的都行：openai / deepseek / siliconflow / zhipu / dashscope / moonshot / ollama / custom
DH_LLM_PROVIDER=
DH_LLM_MODEL=
DH_LLM_BASE_URL=
DH_LLM_API_KEY=

# ---- 默认听觉（ASR）：browser=浏览器原生识别（零成本、零依赖，首选起步方案）----
DH_ASR_PROVIDER=browser
DH_ASR_MODEL=whisper-1
DH_ASR_BASE_URL=
DH_ASR_API_KEY=

# ---- 默认嗓音（TTS）：browser=浏览器语音合成；也可用 openai 兼容 / piper 本机 ----
DH_TTS_PROVIDER=browser
DH_TTS_MODEL=tts-1
DH_TTS_VOICE=zh-CN-XiaoxiaoNeural
DH_TTS_BASE_URL=
DH_TTS_API_KEY=

# ---- 默认眼睛（视觉）：none=关闭比价与识图功能 ----
DH_VLM_PROVIDER=none
DH_VLM_MODEL=
DH_VLM_BASE_URL=
DH_VLM_API_KEY=

# ---- 人格（默认留空 = 不带人格）----
# 留空时她只遵守中性行为规则：说话简短、不编造、不假装做过事。
# 想定制就让使用者在网页「设置 → 人格」里填，或在这里为整个部署定基调。
DH_PERSONA_NAME=
# 例如：DH_PERSONA_STYLE=说话慢一点，喜欢用比喻，偶尔开冷笑话
DH_PERSONA_STYLE=

# 供云端服务商使用的常规环境变量（若不想用上面的 DH_* 变量，可直接设这些）
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# SILICONFLOW_API_KEY=
# MOONSHOT_API_KEY=
